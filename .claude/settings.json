{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "mkdir -p /Users/kangminseong/repository/mybrary/.claude/logs && jq -r '\"[\" + (now | strftime(\"%Y-%m-%dT%H:%M:%S\")) + \"] \" + (.prompt // \"\")' >> /Users/kangminseong/repository/mybrary/.claude/logs/prompts.log"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kangminseong/repository/mybrary/.claude/hooks/guard-edit-write.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kangminseong/repository/mybrary/.claude/hooks/guard-bash.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/kangminseong/repository/mybrary/.claude/hooks/stop-task-check.sh"
          }
        ]
      }
    ]
  }
}
